{
  "name": "@rpgjs/client",
  "version": "4.3.0",
  "description": "",
  "main": "dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && tsc-esm-fix  --target='lib' && npm run build:browser",
    "build:browser": "RPG_TYPE=rpg npx rpgjs build",
    "watch": "tsc -w",
    "dev": "vite build --watch"
  },
  "keywords": [],
  "typesVersions": {
    "*": {
      "react": [
        "src/Gui/React.d.ts"
      ]
    }
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./react": "./src/Gui/React.js"
  },
  "author": "Samuel Ronce",
  "devDependencies": {
    "@canvasengine/compiler": "2.0.0-beta.7",
    "@rpgjs/types": "workspace:*",
    "typescript": "^5.3.3",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "@canvasengine/presets": "2.0.0-beta.7",
    "@rpgjs/common": "workspace:*",
    "@rpgjs/tiled": "workspace:*",
    "@signe/di": "^1.0.2",
    "@signe/sync": "^1.0.3",
    "buffer": "^6.0.3",
    "canvasengine": "2.0.0-beta.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "simple-room-client": "^3.0.1"
  }
}
